# Shared
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
POSTGRES_USER=gearshare
POSTGRES_PASSWORD=gearshare_dev_password
POSTGRES_DB=gearshare
DATABASE_URL=postgresql://gearshare:gearshare_dev_password@localhost:5434/gearshare?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=replace_with_clerk_jwt_public_key_pem
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
JWT_ISSUER=https://clerk.gearshare.local
JWT_AUDIENCE=gearshare-api

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_me

# Stripe Connect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me

# Resend
RESEND_API_KEY=re_replace_me
