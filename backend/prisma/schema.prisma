generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  RENTER
  OWNER
  ADMIN
}

enum EquipmentCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
}

enum BookingStatus {
  PENDING_OWNER_APPROVAL
  APPROVED
  REJECTED
  PAYMENT_PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  CANCELLED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELLED
}

enum InsuranceClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CLOSED
}

enum NotificationType {
  BOOKING
  PAYMENT
  MESSAGE
  REVIEW
  PAYOUT
  SECURITY
  SYSTEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  MEDIATION
  RESOLVED
  CLOSED
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  externalAuthId    String?         @unique
  phone             String?
  status            UserStatus      @default(ACTIVE)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  profile           Profile?
  roleGrants        UserRoleGrant[] @relation("UserRoleGrants")
  issuedRoleGrants  UserRoleGrant[] @relation("IssuedRoleGrants")
  equipment         Equipment[]     @relation("EquipmentOwner")
  renterBookings    Booking[]       @relation("RenterBookings")
  ownerBookings     Booking[]       @relation("OwnerBookings")
  messages          Message[]
  notifications     Notification[]
  favorites         Favorite[]
  reviewsGiven      Review[]        @relation("ReviewAuthor")
  reviewsReceived   Review[]        @relation("ReviewRecipient")
  payouts           Payout[]
  claims            InsuranceClaim[] @relation("Claimant")
  reportsFiled      Report[]        @relation("Reporter")
  auditLogs         AuditLog[]
  conversationLinks ConversationParticipant[]

  @@index([status])
  @@index([createdAt])
}

model UserRoleGrant {
  userId      String
  role        UserRole
  grantedAt   DateTime @default(now())
  grantedById String?

  user        User     @relation("UserRoleGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("IssuedRoleGrants", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  city            String?
  region          String?
  country         String   @default("US")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  identityVerifiedAt DateTime?
  ownerVerifiedAt    DateTime?
  stripeAccountId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String      @id @default(cuid())
  parentId    String?
  slug        String      @unique
  name        String
  description String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent      Category?   @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryChildren")
  equipment   Equipment[]

  @@index([parentId])
  @@index([sortOrder])
}

model Equipment {
  id                  String             @id @default(cuid())
  ownerId             String
  categoryId          String
  slug                String
  title               String
  description         String
  condition           EquipmentCondition
  pricePerHourCents   Int?
  pricePerDayCents    Int
  depositAmountCents  Int
  currency            String             @default("USD")
  minimumRentalHours  Int                @default(4)
  maximumRentalDays   Int                @default(30)
  deliveryAvailable   Boolean            @default(false)
  deliveryFeeCents    Int?
  locationName        String
  addressLine1        String?
  addressLine2        String?
  city                String
  region              String
  country             String             @default("US")
  postalCode          String?
  latitude            Decimal?           @db.Decimal(9, 6)
  longitude           Decimal?           @db.Decimal(9, 6)
  specifications      Json?
  isPublished         Boolean            @default(false)
  publishedAt         DateTime?
  ratingAverage       Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount         Int                @default(0)
  bookingCount        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  owner               User               @relation("EquipmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              EquipmentImage[]
  availability        EquipmentAvailability[]
  bookings            Booking[]
  conversations       Conversation[]
  favorites           Favorite[]
  reviews             Review[]
  featuredListings    FeaturedListing[]
  claims              InsuranceClaim[]
  reports             Report[]

  @@unique([ownerId, slug])
  @@index([categoryId, isPublished])
  @@index([city, region])
  @@index([pricePerDayCents])
  @@index([ratingAverage])
  @@index([createdAt])
}

model EquipmentImage {
  id          String    @id @default(cuid())
  equipmentId String
  url         String
  cloudinaryPublicId String
  altText     String
  width       Int?
  height      Int?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, sortOrder])
}

model EquipmentAvailability {
  id          String    @id @default(cuid())
  equipmentId String
  date        DateTime
  isAvailable Boolean   @default(true)
  startTime   DateTime?
  endTime     DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, date])
  @@index([date, isAvailable])
}

model Booking {
  id                    String        @id @default(cuid())
  renterId              String
  ownerId               String
  equipmentId           String
  status                BookingStatus @default(PENDING_OWNER_APPROVAL)
  startsAt              DateTime
  endsAt                DateTime
  rentalSubtotalCents   Int
  deliveryFeeCents      Int           @default(0)
  serviceFeeCents       Int
  depositAmountCents    Int
  totalAmountCents      Int
  currency              String        @default("USD")
  deliveryRequested     Boolean       @default(false)
  deliveryAddress       Json?
  ownerNote             String?
  renterNote            String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  renter                User          @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Restrict)
  owner                 User          @relation("OwnerBookings", fields: [ownerId], references: [id], onDelete: Restrict)
  equipment             Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  payment               Payment?
  reviews               Review[]
  conversation          Conversation?
  messages              Message[]
  claim                 InsuranceClaim?
  disputes              Dispute[]

  @@index([renterId, status])
  @@index([ownerId, status])
  @@index([equipmentId, startsAt, endsAt])
  @@index([createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  stripePaymentIntentId String        @unique
  stripeChargeId        String?
  status                PaymentStatus
  amountCents           Int
  platformFeeCents      Int
  ownerPayoutCents      Int
  currency              String        @default("USD")
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payout                Payout?

  @@index([status])
  @@index([createdAt])
}

model Review {
  id          String    @id @default(cuid())
  bookingId   String
  equipmentId String
  reviewerId  String
  revieweeId  String
  rating      Int
  body        String
  ownerReply  String?
  moderatedAt DateTime?
  hiddenAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reviewer    User      @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee    User      @relation("ReviewRecipient", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([bookingId, reviewerId])
  @@index([equipmentId, hiddenAt])
  @@index([revieweeId])
}

model Conversation {
  id          String    @id @default(cuid())
  bookingId   String?   @unique
  equipmentId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages    Message[]

  @@index([equipmentId])
  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId    String
  userId            String
  lastReadMessageId String?
  joinedAt          DateTime @default(now())
  archivedAt        DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  bookingId      String?
  body           String?
  imageUrl       String?
  sentAt         DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model Favorite {
  userId      String
  equipmentId String
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([userId, equipmentId])
  @@index([equipmentId])
}

model Payout {
  id             String       @id @default(cuid())
  ownerId        String
  paymentId      String?      @unique
  stripePayoutId String?      @unique
  status         PayoutStatus @default(PENDING)
  amountCents    Int
  currency       String       @default("USD")
  expectedAt     DateTime?
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
}

model InsuranceClaim {
  id                    String               @id @default(cuid())
  bookingId             String               @unique
  equipmentId           String
  claimantId            String
  status                InsuranceClaimStatus @default(OPEN)
  description           String
  evidence              Json?
  estimatedDamageCents  Int?
  approvedAmountCents   Int?
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  booking               Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  equipment             Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  claimant              User                 @relation("Claimant", fields: [claimantId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([equipmentId])
}

model FeaturedListing {
  id          String    @id @default(cuid())
  equipmentId String
  placement   String    @default("homepage")
  startsAt    DateTime
  endsAt      DateTime
  priceCents  Int
  createdAt   DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([placement, startsAt, endsAt])
  @@index([equipmentId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  equipmentId String?
  status      ReportStatus @default(OPEN)
  reason      String
  details     String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  equipment   Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([equipmentId])
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String
  status      DisputeStatus @default(OPEN)
  reason      String
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
